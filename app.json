{
  "expo": {
    "name": "필람",
    "slug": "pillarm",
    "scheme": "pillarm",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.seungrokj.pillarm",
      "buildNumber": "34",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "약 복용 사진을 찍기 위해 카메라 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "약 복용 사진을 첨부하기 위해 사진 접근 권한이 필요합니다.",
        "NSUserNotificationsUsageDescription": "복용 시간 알림을 보내기 위해 필요합니다."
      }
    },
    "android": {
      "package": "com.seungrokj.pillarm",
      "versionCode": 23,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3b82f6",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "보호 그룹 초대 QR 코드를 스캔하기 위해 카메라 접근 권한이 필요합니다.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.131302702516-igvegcggjg5mk6pc8nfllaalda99scul"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "8dc3f74482bc4d09a9c1c8502acf99c4",
          "isKakaoTalkLoginAvailable": true,
          "android": {
            "authCodeHandlerActivity": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "약 복용 사진을 첨부하기 위해 사진 접근 권한이 필요합니다.",
          "cameraPermission": "약 복용 사진을 찍기 위해 카메라 접근 권한이 필요합니다.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          },
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "67c4ebb9-813e-4d76-b1b7-9077791975d2"
      }
    },
    "owner": "seungrok-j"
  }
}
